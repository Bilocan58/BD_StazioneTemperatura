Questo codice che troviamo qui sotto rappresenta un Esp32 che si connette al wifi e crea il sito per mostrare la tempratura.
E una cosa aggiuntiva e che se il microcontrollore non riesce a connettersi apre un led e se si e connesso allora rimane chiuso.
Ecco il codice:
#include <WiFi.h>
#include <WebServer.h>
#include <ESPmDNS.h>
#include <OneWire.h>
#include <DallasTemperature.h>

// ====== CONFIGURA QUI ======
const char* WIFI_SSID     = "NomeWifi";
const char* WIFI_PASSWORD = "WifiPassword";
// ===========================

#define ONE_WIRE_BUS 1   // pin dati del DS18B20 (ESP32-C3)
#define LED_WIFI 2    // LED di stato: ACCESO = NON connesso, SPENTO = connesso

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
WebServer server(80);

float lastTemp = NAN;
bool sensorOk = false;
float minTemp = NAN, maxTemp = NAN;
unsigned long lastRequest = 0;
bool waitingConversion = false;
const unsigned long READ_INTERVAL = 2000;

const char INDEX_HTML[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Termometro ESP32</title>
<style>
  :root {
    --bg: #0f172a; --card: #1e293b; --text: #f1f5f9; --muted: #94a3b8;
    --accent: #38bdf8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; display: flex; align-items: center;
    justify-content: center; background: var(--bg); color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .card {
    background: var(--card); border-radius: 24px; padding: 40px 48px;
    text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,.4);
    width: min(92vw, 420px);
  }
  h1 { font-size: 1.1rem; font-weight: 500; color: var(--muted); margin: 0 0 16px; letter-spacing: .05em; text-transform: uppercase; }
  .temp { font-size: 5rem; font-weight: 700; line-height: 1; color: var(--accent); transition: color .5s; }
  .temp small { font-size: 2rem; font-weight: 500; color: var(--muted); }
  .status { margin-top: 20px; font-size: .9rem; color: var(--muted); display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: #22c55e; }
  .dot.err { background: #ef4444; }
  .minmax { display: flex; justify-content: space-around; margin-top: 28px; padding-top: 20px; border-top: 1px solid #334155; }
  .minmax div span { display: block; font-size: .75rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .minmax div b { font-size: 1.3rem; }
</style>
</head>
<body>
  <div class="card">
    <h1>Temperatura attuale</h1>
    <div class="temp" id="temp">--<small>&deg;C</small></div>
    <div class="status"><span class="dot err" id="dot"></span><span id="msg">In attesa dei dati...</span></div>
    <div class="minmax">
      <div><span>Min</span><b id="min">--</b></div>
      <div><span>Max</span><b id="max">--</b></div>
    </div>
  </div>
<script>
  const tempEl = document.getElementById('temp');
  const dot = document.getElementById('dot');
  const msg = document.getElementById('msg');

  function colorFor(t) {
    if (t < 10) return '#60a5fa';
    if (t < 20) return '#38bdf8';
    if (t < 28) return '#4ade80';
    if (t < 35) return '#fb923c';
    return '#ef4444';
  }

  async function update() {
    try {
      const r = await fetch('/temp', { cache: 'no-store' });
      const d = await r.json();
      if (d.ok) {
        tempEl.innerHTML = d.temp.toFixed(1) + '<small>&deg;C</small>';
        tempEl.style.color = colorFor(d.temp);
        document.getElementById('min').textContent = d.min.toFixed(1) + '°';
        document.getElementById('max').textContent = d.max.toFixed(1) + '°';
        dot.className = 'dot';
        msg.textContent = 'Aggiornato alle ' + new Date().toLocaleTimeString('it-IT');
      } else {
        throw new Error('sensore');
      }
    } catch (e) {
      dot.className = 'dot err';
      msg.textContent = 'Sensore non raggiungibile';
    }
  }
  update();
  setInterval(update, 2000);
</script>
</body>
</html>
)rawliteral";

void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleTemp() {
  String json;
  if (sensorOk) {
    json = "{\"ok\":true,\"temp\":" + String(lastTemp, 2) +
           ",\"min\":" + String(minTemp, 2) +
           ",\"max\":" + String(maxTemp, 2) + "}";
  } else {
    json = "{\"ok\":false}";
  }
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

// Lettura non bloccante: il server resta reattivo durante la conversione
void updateSensor() {
  unsigned long now = millis();

  if (!waitingConversion && now - lastRequest >= READ_INTERVAL) {
    sensors.requestTemperatures();
    lastRequest = now;
    waitingConversion = true;
  } else if (waitingConversion && now - lastRequest >= 800) {
    float t = sensors.getTempCByIndex(0);
    waitingConversion = false;

    if (t != DEVICE_DISCONNECTED_C) {
      lastTemp = t;
      sensorOk = true;
      if (isnan(minTemp) || t < minTemp) minTemp = t;
      if (isnan(maxTemp) || t > maxTemp) maxTemp = t;
      Serial.printf("Temperatura: %.2f °C\n", t);
    } else {
      sensorOk = false;
      Serial.println("Errore: impossibile leggere dal sensore DS18B20!");
    }
  }
}

void setup() {
  Serial.begin(115200);
  sensors.begin();
  sensors.setWaitForConversion(false);  // conversione asincrona
  Serial.println("Inizializzazione DS18B20 completata.");

  pinMode(LED_WIFI, OUTPUT);
  digitalWrite(LED_WIFI, HIGH);   // acceso finché non siamo connessi

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);    // si riconnette da solo se cade la rete
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connessione al WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  digitalWrite(LED_WIFI, LOW);    // connesso: LED spento
  Serial.println();
  Serial.print("Connesso! Apri nel browser: http://");
  Serial.println(WiFi.localIP());

  if (MDNS.begin("termometro")) {
    Serial.println("Oppure: http://termometro.local");
  }

  server.on("/", handleRoot);
  server.on("/temp", handleTemp);
  server.begin();
}

void loop() {
  // LED acceso se il WiFi è caduto, spento se connesso
  digitalWrite(LED_WIFI, WiFi.status() == WL_CONNECTED ? LOW : HIGH);

  server.handleClient();
  updateSensor();
}
