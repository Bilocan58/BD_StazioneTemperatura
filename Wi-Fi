Componenti essenziali

-ESP32 DevKit (qualsiasi versione, tipo ESP32-WROOM-32)
-Sensore di temperatura DS18B20
-Resistenza pull-up da 4.7 kΩ
-Breadboard 830 punti
-Cavi jumper dupont maschio-maschio
-Cavo USB per ESP32 (per caricare il codice)
-Alimentazione 3.3V o 5V, se vuoi provarlo fuori dal PC

Codice per wi-fi;

#include <WiFi.h>

const char* ssid = "NOME_DELLA_TUA_RETE";
const char* password = "PASSWORD_DELLA_RETE";

const int ledPin = 2; // Pin del LED (modifica se usi un pin diverso)

void setup() {
  Serial.begin(115200);

  // Configura il pin del LED come uscita
  pinMode(ledPin, OUTPUT);
  // Accendi il LED all'inizio (1 = disconnesso)
  digitalWrite(ledPin, HIGH);

  WiFi.begin(ssid, password);
  Serial.print("Connessione in corso...");
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    // Wi-Fi connesso -> LED spento (0)
    digitalWrite(ledPin, LOW);
  } else {
    // Wi-Fi non connesso -> LED acceso (1)
    digitalWrite(ledPin, HIGH);
    
    // Tenta il riconnessione se si è perso il segnale
    WiFi.begin(ssid, password);
  }

  delay(2000); // Controllo ogni 2 secondi
}


